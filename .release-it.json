{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "hooks": {
    "before:init": ["pnpm typecheck", "pnpm lint", "pnpm format:check"],
    "after:bump": [
      "node scripts/sync-module-range.mts ${version}",
      "git add README.md docs CHANGELOG.md"
    ]
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true
  }
}
