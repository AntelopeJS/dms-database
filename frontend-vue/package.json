{
	"name": "@antelopejs/dms-database-frontend-vue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./dms.frontend.ts",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"@antelopejs/dms-frontend": ">=0.11.11 <0.12.0"
	},
	"scripts": {
		"dev": "pnpm --dir ../playground frontend:dev",
		"build": "pnpm --dir ../playground exec ajs dms build",
		"typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
		"format": "prettier --write .",
		"lint": "pnpm -s run types && eslint .",
		"lint:fix": "pnpm -s run types && eslint . --fix",
		"types": "pnpm --dir .. exec ajs dms prepare-types -q --module frontend-vue --out frontend-vue/.dms-types",
		"test": "pnpm -s run types && vitest run"
	},
	"dependencies": {
		"@antelopejs/interface-core": ">=0.5.2 <0.6.0",
		"@antelopejs/interface-database": ">=0.4.0 <0.5.0",
		"@codemirror/autocomplete": "^6.18.6",
		"@codemirror/commands": "^6.8.1",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/language": "^6.11.0",
		"@codemirror/state": "^6.5.2",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.38.1",
		"@dagrejs/dagre": "^3.0.0",
		"@vue-flow/core": "^1.48.2",
		"@vueuse/core": "^14.3.0",
		"vue": "^3.5.18"
	},
	"devDependencies": {
		"@antelopejs/tooling-configs": ">=0.10.12 <0.11.0",
		"@intlify/message-compiler": "^11",
		"@nuxt/eslint-config": "^1.17.0",
		"@nuxt/ui": "4.10.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"eslint": "^10.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"typescript": "^5.8.2",
		"vite": ">=8.4.0 <8.5.0",
		"vitest": "^3.2.4"
	}
}
