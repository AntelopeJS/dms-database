{
	"name": "@antelopejs/dms-database-frontend-vue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./dms.frontend.ts",
	"packageManager": "pnpm@10.6.5",
	"scripts": {
		"dev": "pnpm --dir ../playground frontend:dev",
		"build": "pnpm --dir ../playground exec ajs-dms build",
		"typecheck": "pnpm --dir \"${DMS_FRONTEND_WORKSPACE:?Set DMS_FRONTEND_WORKSPACE to the generated Inertia workspace}\" typecheck",
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run"
	},
	"dependencies": {
		"@antelopejs/interface-core": ">=0.0.13 <1.0.0",
		"@antelopejs/interface-database": ">=0.1.7 <1.0.0",
		"@codemirror/autocomplete": "^6.18.6",
		"@codemirror/commands": "^6.8.1",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/language": "^6.11.0",
		"@codemirror/state": "^6.5.2",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.38.1",
		"@dagrejs/dagre": "^3.0.0",
		"@vue-flow/core": "^1.48.2",
		"@vueuse/core": "^13.0.0",
		"vue": "^3.5.18"
	},
	"devDependencies": {
		"@nuxt/ui": "4.10.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-vue": "^10.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"typescript": "^5.8.2",
		"vitest": "^3.2.4"
	}
}
