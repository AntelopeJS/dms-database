{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 16,
    "antelopejs/no-presence-only-type-guard": 4,
    "anti-slop/no-known-value-widening": 3,
    "anti-slop/no-runtime-typeof": 1,
    "anti-slop/no-unknown-parameters": 9,
    "anti-slop/no-unsafe-dictionary-type": 20,
    "anti-slop/require-safety-comment-for-type-assertion": 7,
    "typescript/no-unsafe-argument": 29,
    "typescript/no-unsafe-assignment": 39,
    "typescript/no-unsafe-return": 21,
    "typescript/use-unknown-in-catch-callback-variable": 1
  },
  "oversizeFiles": {}
}
