{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 5,
    "anti-slop/no-runtime-typeof": 1,
    "anti-slop/no-unknown-parameters": 5,
    "anti-slop/no-unsafe-dictionary-type": 11,
    "anti-slop/require-safety-comment-for-type-assertion": 3,
    "typescript/no-unsafe-argument": 5,
