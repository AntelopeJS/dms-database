{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 6,
    "anti-slop/no-known-value-widening": 1,
    "anti-slop/no-runtime-typeof": 1,
    "anti-slop/no-unknown-parameters": 6,
    "anti-slop/no-unsafe-dictionary-type": 12,
    "anti-slop/require-safety-comment-for-type-assertion": 1,
    "typescript/no-unsafe-argument": 4,
    "typescript/no-unsafe-assignment": 7,
    "typescript/no-unsafe-return": 4
  },
  "oversizeFiles": {}
}
