{
  "rules": {
    "anti-slop/no-chained-type-assertions": 0,
    "anti-slop/no-object-parameters": 0,
    "anti-slop/no-runtime-typeof": 0,
    "anti-slop/no-unknown-parameters": 2,
    "anti-slop/no-unsafe-dictionary-type": 0,
    "eslint/max-params": 0,
    "typescript/no-base-to-string": 0,
    "typescript/no-unsafe-assignment": 0,
    "typescript/unbound-method": 0
  },
  "tsExpectError": 0,
  "tsIgnore": 0,
  "safety": 0,
  "config": {
    "vue/multi-word-component-names for frontend-vue/**/*.vue": 0
  },
  "agentFiles": true
}
