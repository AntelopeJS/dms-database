{
  "name": "@antelopejs/dms-database",
  "version": "0.4.4",
  "description": "Database console for the AntelopeJS DMS: schemas, relation diagrams, a data browser and an AQL query console.",
  "keywords": [
    "admin",
    "antelopejs",
    "aql",
    "database",
    "dms",
    "dms-module"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/database",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-database/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-database.git"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev:frontend": "pnpm frontend:dev",
    "dev": "ajs project run -w -p playground",
    "generate": "ajs module exports generate",
    "lint:fix": "oxlint --fix && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "lint": "oxlint && pnpm --dir frontend-vue lint && node scripts/check-sources.mts && node node_modules/@antelopejs/dms/frontend-vue/scripts/check-api-error-presentation.mjs frontend-vue/app",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "test": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && DMS_PREBUILT=1 ajs module test .",
    "release": "pnpm --dir frontend-vue install --frozen-lockfile && release-it",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "test:layer": "pnpm --dir frontend-vue test",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-api-util": ">=0.3.2 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.1 <0.6.0",
    "@antelopejs/interface-database": ">=0.4.0 <0.5.0",
    "@antelopejs/interface-database-catalog": ">=0.0.4 <0.1.0",
    "@antelopejs/interface-database-decorators": ">=0.5.2 <0.6.0",
    "@antelopejs/interface-dms": ">=0.14.0 <0.15.0"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.23.2",
    "@antelopejs/dms": ">=0.20.0 <0.21.0",
    "@antelopejs/dms-frontend": ">=0.11.1 <0.12.0",
    "@antelopejs/interface-data-api": ">=0.8.0 <0.9.0",
    "@antelopejs/mongodb": "~1.8.1",
    "@antelopejs/tooling-configs": ">=0.7.1 <0.8.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "chai": "^6.2.2",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mocha": "^12.0.0",
    "mongodb": "^6.21.0",
    "mongodb-memory-server-core": "^11.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-automation": ">=0.6.2 <0.7.0",
    "@antelopejs/interface-dms-builder": ">=0.5.1 <0.6.0"
  },
  "packageManager": "pnpm@10.33.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [],
    "test": "src/test/harness.ts",
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
