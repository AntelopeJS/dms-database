{
  "name": "@antelopejs/dms-database",
  "version": "0.3.1",
  "description": "Database console for the AntelopeJS DMS: schemas, relation diagrams, a data browser and an AQL query console.",
  "keywords": [
    "admin",
    "antelopejs",
    "aql",
    "database",
    "dms",
    "dms-module"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/database",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-database/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-database.git"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev:frontend": "pnpm frontend:dev",
    "dev": "ajs project run -w -p playground",
    "generate": "ajs module exports generate",
    "lint:fix": "oxlint --fix && oxfmt . && pnpm --dir frontend-vue lint:fix",
    "lint": "oxlint && pnpm --dir frontend-vue lint && node scripts/check-sources.mts && antelopejs-check-interface-ranges",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt . && pnpm --dir frontend-vue format",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "test": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && DMS_PREBUILT=1 ajs module test .",
    "release": "pnpm --dir frontend-vue install --frozen-lockfile && release-it",
    "prepack": "pnpm run build",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "test:layer": "pnpm --dir frontend-vue test",
    "test:frontend": "ajs dms verify-source --layer node_modules/@antelopejs/dms/frontend-vue --module frontend-vue",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "format:check": "oxfmt --check .",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-f206be7.tgz",
    "@antelopejs/interface-api-util": "file:.campaign/tgz/antelopejs-interface-api-util-cc740f8.tgz",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
    "@antelopejs/interface-database-decorators": "file:.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
    "@antelopejs/interface-dms": "file:.campaign/tgz/antelopejs-interface-dms-50e3adc.tgz"
  },
  "devDependencies": {
    "@antelopejs/core": ">=1.17.1 <2",
    "@antelopejs/dms": "file:.campaign/tgz/antelopejs-dms-50e3adc.tgz",
    "@antelopejs/dms-frontend": ">=0.9.1 <0.10.0",
    "@antelopejs/interface-data-api": "file:.campaign/tgz/antelopejs-interface-data-api-e070b68.tgz",
    "@antelopejs/mongodb": "file:.campaign/tgz/antelopejs-mongodb-db4b449.tgz",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "chai": "^6.2.2",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mocha": "^12.0.0",
    "mongodb-memory-server-core": "^11.2.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-automation": "file:.campaign/tgz/antelopejs-interface-dms-automation-b4bc5d2.tgz"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-f206be7.tgz",
      "@antelopejs/interface-api-util": "file:.campaign/tgz/antelopejs-interface-api-util-cc740f8.tgz",
      "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
      "@antelopejs/interface-database-decorators": "file:.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
      "@antelopejs/interface-data-api": "file:.campaign/tgz/antelopejs-interface-data-api-e070b68.tgz",
      "@antelopejs/interface-dms": "file:.campaign/tgz/antelopejs-interface-dms-50e3adc.tgz",
      "@antelopejs/dms": "file:.campaign/tgz/antelopejs-dms-50e3adc.tgz",
      "@antelopejs/dms>@antelopejs/interface-core": "0.2.4",
      "@antelopejs/interface-dms-automation": "file:.campaign/tgz/antelopejs-interface-dms-automation-b4bc5d2.tgz"
    }
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [],
    "test": "src/test/harness.ts",
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
